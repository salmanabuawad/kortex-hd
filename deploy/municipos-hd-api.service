[Unit]
Description=MunicipOS Helpdesk API for support.kortexd.com/hd (FastAPI/uvicorn)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=municipos
Group=municipos
WorkingDirectory=/opt/municipos-helpdesk-hd/backend
EnvironmentFile=/opt/municipos-helpdesk-hd/backend/.env
ExecStart=/opt/municipos-helpdesk-hd/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8073 --workers 2
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
