[Unit]
Description=MunicipOS Helpdesk API (FastAPI/uvicorn)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=municipos
Group=municipos
WorkingDirectory=/opt/municipos-helpdesk/backend
EnvironmentFile=/opt/municipos-helpdesk/backend/.env
ExecStart=/opt/municipos-helpdesk/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8071 --workers 2
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
