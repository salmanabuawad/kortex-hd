server {
    listen 80;
    listen [::]:80;
    server_name support.buqata.muni.il;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name support.buqata.muni.il;

    ssl_certificate /etc/letsencrypt/live/support.buqata.muni.il/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/support.buqata.muni.il/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "same-origin" always;

    root /opt/municipos-helpdesk/frontend/dist;
    index index.html;

    # API -> FastAPI (uvicorn) on 127.0.0.1:8060
    location /api/ {
        proxy_pass http://127.0.0.1:8060;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Hashed build assets: serve directly, 404 on a stale hash (never fall back
    # to index.html — that causes MIME-type errors). Long-cache immutable files.
    location /assets/ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # index.html must never be cached, so clients always get the latest asset refs.
    location = /index.html {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
    }

    # SPA — serve index.html for client-side routes (incl. /external/<token>)
    location / {
        try_files $uri $uri/ /index.html;
    }

    client_max_body_size 64m;
}
