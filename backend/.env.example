# Copy to backend/.env and fill in. Never commit the real .env.
ENV=development                    # set to "production" on the server
DATABASE_URL=postgresql+psycopg2://municipos:municipos@localhost:5433/municipos
JWT_SECRET=                        # REQUIRED in production: openssl rand -hex 32
FRONTEND_URL=http://localhost:5173 # https://support.buqata.muni.il on the server
UPLOAD_DIR=uploads
TOKEN_TTL_HOURS=12
PUBLIC_BASE_URL=http://localhost:5173   # base for external guest links
MAX_UPLOAD_MB=20
LOGIN_RATE_LIMIT=8                      # failed logins per 5 minutes per address
GUEST_RATE_LIMIT=60

# Notification providers: "log" records without sending. Set EMAIL_PROVIDER=smtp
# plus the SMTP_* values to send real mail.
EMAIL_PROVIDER=log
SMS_PROVIDER=log
WHATSAPP_PROVIDER=log
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=helpdesk@buqata.muni.il
COUNCIL_NAME=מועצה מקומית בוקעאתא

# Consumed by `python -m app.seed` only.
ADMIN_EMAIL=admin@buqata.muni.il
ADMIN_NAME=מנהל מערכת
ADMIN_PASSWORD=
